<section class="section">
  <div class="container">
    <p class="label">Colección</p>
    <h1 class="h2">{{ collection.title }}</h1>
    {% if collection.description != blank %}<p class="lead">{{ collection.description }}</p>{% endif %}
    <div class="products-grid">
      {% paginate collection.products by 12 %}
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>No hay productos en esta colección todavía.</p>
        {% endfor %}
        {% if paginate.pages > 1 %}
          <nav class="hero-actions" aria-label="Paginación">
            {{ paginate | default_pagination }}
          </nav>
        {% endif %}
      {% endpaginate %}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Colección principal", "settings": [] }
{% endschema %}
