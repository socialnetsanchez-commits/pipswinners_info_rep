<section class="section" id="productos">
  <div class="container">
    <p class="label">{{ section.settings.eyebrow }}</p>
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.subheading }}</p>
    <div class="products-grid">
      {% assign selected_collection = section.settings.collection | default: collections.frontpage %}
      {% for product in selected_collection.products limit: section.settings.limit %}
        {% render 'product-card', product: product %}
      {% else %}
        {% for i in (1..3) %}
          <article class="product-card">
            <div class="product-placeholder"></div>
            <span class="badge">Producto ejemplo</span>
            <h3>Producto ganador {{ i }}</h3>
            <p>Añade tus productos desde Shopify Admin para que aparezcan aquí.</p>
            <span class="price">Configurar precio</span>
          </article>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Catálogo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Productos listos para escalar" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Selecciona una colección de Shopify para mostrar tus productos de dropshipping, bundles o productos digitales." },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "label": "Cantidad", "min": 3, "max": 12, "step": 1, "default": 6 }
  ],
  "presets": [{ "name": "Productos destacados" }]
}
{% endschema %}
