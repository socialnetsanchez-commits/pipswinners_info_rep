<section class="section">
  <div class="container">
    <p class="label">{{ section.settings.eyebrow }}</p>
    <h2 class="h2">{{ section.settings.heading }}</h2>
    <p class="lead">{{ section.settings.subheading }}</p>
    <div class="card-grid">
      {% for block in section.blocks %}
        <article class="card" {{ block.shopify_attributes }}>
          <p class="label">{{ block.settings.step }}</p>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Stack de automatización",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Sistema operativo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Marketing y soporte listos para automatizar" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Configura estas piezas en Shopify Apps y conecta cada evento con Zapier para reducir trabajo manual." }
  ],
  "blocks": [
    {
      "type": "automation",
      "name": "Automatización",
      "settings": [
        { "type": "text", "id": "step", "label": "Paso", "default": "01" },
        { "type": "text", "id": "title", "label": "Título", "default": "Creativos con IA" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Genera imágenes, UGC scripts y variantes de anuncios con IA; súbelos a Meta, TikTok y Google desde tu gestor de campañas." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stack de automatización",
      "blocks": [
        { "type": "automation", "settings": { "step": "01", "title": "Creativos con IA", "text": "Usa ChatGPT y herramientas de imagen/video para crear hooks, guiones UGC, copies y variantes de anuncios por producto." } },
        { "type": "automation", "settings": { "step": "02", "title": "Email y SMS", "text": "Conecta Shopify Email, Klaviyo o Omnisend para bienvenida, carrito abandonado, postcompra, reseñas y winback." } },
        { "type": "automation", "settings": { "step": "03", "title": "Chatbot + Zapier", "text": "Automatiza preguntas frecuentes, tickets, alertas de pedidos, hojas de cálculo, CRM y mensajes internos cuando ocurra una venta." } }
      ]
    }
  ]
}
{% endschema %}
